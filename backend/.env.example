# ---------- Server ----------
PORT=5000
NODE_ENV=development

# Frontend address allowed to call this API (comma separated if more than one)
CLIENT_URL=http://localhost:5173

# ---------- MongoDB ----------
# Local MongoDB:   mongodb://127.0.0.1:27017
# MongoDB Atlas:   mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017
# Name of the database inside MongoDB
DB_NAME=spicy_biryani

# ---------- Login (JWT) ----------
# Any long random text. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# ---------- Admin account (created automatically on first start) ----------
ADMIN_EMAIL=admin@spicybiryani.com
ADMIN_PASSWORD=change-this-password
